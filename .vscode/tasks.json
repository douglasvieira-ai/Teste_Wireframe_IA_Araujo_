{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ng serve",
      "type": "shell",
      "command": "npm.cmd start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building|Application bundle generation",
          "endsPattern": "Local:|Application bundle generation complete|Compiled successfully|Failed to compile"
        }
      }
    }
  ]
}
